{
  "name": "nexus-full",
  "private": true,
  "version": "2.0.0",
  "author": "Nexus",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "build:lite": "set \"VITE_APP_EDITION=lite\" && vite build --outDir dist-lite",
    "build:gh": "set VITE_BASE_URL=./ && vite build",
    "start": "set STANDALONE=true && set PORT=4050 && node api-server.js",
    "start:lite": "set STANDALONE=true && set PORT=4060 && set APP_EDITION=lite && set NEXUS_DATA_DIR=%APPDATA%\\Nexus Lite && node api-server.js",
    "electron": "electron .",
    "electron:dist": "npm run build && node herramientas/build-exe.cjs && electron-builder",
    "electron:dist:lite": "npm run build:lite && electron-builder --config electron/builder.lite.cjs",
    "electron:dist:demo-full": "npm run build && node herramientas/build-exe.cjs && node herramientas/seed-demo-db.mjs && electron-builder --config electron/builder.demo-full.cjs",
    "electron:dist:demo-lite": "npm run build:lite && node herramientas/build-exe.cjs && node herramientas/seed-demo-db.mjs && electron-builder --config electron/builder.demo-lite.cjs"
  },
  "build": {
    "appId": "com.nexusfull.app",
    "productName": "Nexus Full",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "NexusFull.exe",
        "to": "server/NexusFull.exe"
      },
      {
        "from": "electron/edition-full.json",
        "to": "server/edition.json"
      },
      {
        "from": "native/",
        "to": "server/native/"
      },
      {
        "from": "dist/",
        "to": "server/dist/"
      },
      {
        "from": "web/",
        "to": "server/web/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Full"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.1",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
